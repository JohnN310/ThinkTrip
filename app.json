{
  "expo": {
    "name": "ThinkTrip",
    "slug": "thinktrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "thinktrip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "ThinkTrip uses your camera to decode menu ingredients, explain payment etiquette, and read transit signage."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "ThinkTrip uses your camera to decode menu ingredients, explain payment etiquette, and read transit signage."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}